{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
     "buffer": 57000,
    "keep": {
       "tokens": 3800
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "/home/kali/macbookpro/**": "allow",
      "/home/kali/**": "allow",
      "/home/kali/Imágenes/**": "allow",
      "/home/kali/Descargas/**": "allow",
      "/home/kali/Documentos/**": "allow",
      "/home/kali/Escritorio/**": "allow"
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@modelcontextprotocol/server-filesystem@latest",
        "/home/kali"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@upstash/context7-mcp@latest"
      ]
    },
    "notion": {
      "type": "local",
      "enabled": false,
      "command": [
        "/home/kali/.nvm/versions/node/v20.20.2/bin/npx",
        "@notionhq/notion-mcp-server"
      ]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/usr/bin/chromium"
      }
    },
    "blender-mcp": {
      "type": "local",
      "enabled": false,
      "command": [
        "/home/kali/.local/bin/blender-mcp"
      ]
    },
    "codebase-index": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "--package",
        "opencode-codebase-index",
        "opencode-codebase-index-mcp",
        "--project",
        "."
      ],
      "env": {
        "OLLAMA_HOST": "http://192.168.2.138:11434",
        "EMBEDDING_PROVIDER": "ollama",
        "OLLAMA_BASE_URL": "http://192.168.2.138:11434",
        "EMBEDDING_MODEL": "nomic-embed-text"
      }
    }
  },
  "provider": {
    "omlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MacBook Pro oMLX",
      "tool_parser": "markdown",
      "tools_format": "xml",
      "strict_tools": false,
      "options": {
        "baseURL": "http://192.168.2.138:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-4bit": {
          "name": "Qwen3.6-35B-A3B-4bit",
          "limit": {
             "context": 81920,
            "output": 8192
          },
          "cost": {
            "input": 0.17,
            "output": 0.69
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "max_thinking_tokens": 2048
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "temperature": 0.6,
      "topP": 0.95
    },
    "build": {
      "temperature": 0.6,
      "topP": 0.95
    }
  },
  "model": "Qwen3.6-35B-A3B-4bit",
  "plugin": [
    "oc-tps@latest",
    "opencode-codebase-index"
  ],
  "skills": [
    "https://github.com/dammyjay93/interface-design --skill interface-design",
    "https://github.com/obra/superpowers --skill brainstorming",
    "https://github.com/obra/superpowers --skill systematic-debugging",
    "https://github.com/microsoft/playwright-cli --skill playwright-cli"
  ],
  "shell": "/usr/bin/zsh"
}
