{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": 45000,
    "keep": {
      "tokens": 3000
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "/home/kali/macbookpro/**": "allow",
      "/home/kali/**": "allow"
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@modelcontextprotocol/server-filesystem@latest",
        "/home/kali"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@upstash/context7-mcp@latest"
      ]
    },
    "notion": {
      "type": "local",
      "enabled": false,
      "command": [
        "/home/kali/.nvm/versions/node/v20.20.2/bin/npx",
        "@notionhq/notion-mcp-server"
      ]
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/usr/bin/chromium"
      }
    }
  },
  "provider": {
    "omlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MacBook Pro oMLX",
      "options": {
        "baseURL": "http://192.168.2.138:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-4bit": {
          "name": "Qwen3.6-35B-A3B-4bit",
          "limit": {
            "context": 64000,
            "output": 8192
          },
          "cost": {
            "input": 0.17,
            "output": 0.69
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
  },
  "agent": {
    "plan": {
      "temperature": 0.6,
      "topP": 0.95
    },
    "build": {
      "temperature": 0.6,
      "topP": 0.95
    }
  },
  "model": "Qwen3.6-35B-A3B-4bit",
  "plugin": [
    "oc-tps@latest"
  ],
  "shell": "/usr/bin/zsh"
}
