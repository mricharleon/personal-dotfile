{
  // URL del schema JSON oficial de opencode (validación de estructura)
  "$schema": "https://opencode.ai/config.json",

  // --- Compacción automática de contexto ---
  "compaction": {
    // Activa la compacción automática (resumir conversación cuando se acerca al límite)
    "auto": true,
    // Permite la poda/agregación de mensajes antiguos durante la compacción
    "prune": true,
    // Tokens de margen desde el límite del contexto antes de disparar compacción (5K = compacta a ~70K)
    "reserved": 5000,
    // Tokens mínimos que se preservan intactos al inicio de la conversación (instrucciones del sistema)
    "preserve_recent_tokens": 3800,
    // Número de turnos recientes que se mantienen completos sin poda durante la compacción
    "tail_turns": 3
  },

  // --- Permisos de directorios externos ---
  "permission": {
    "external_directory": {
      // Acceso al directorio de config de opencode
      "~/.config/opencode/**": "allow",
      // Acceso al home del usuario remoto (macbookpro)
      "/home/kali/macbookpro/**": "allow",
      // Acceso completo al home del usuario local
      "/home/kali/**": "allow",
      // Acceso a la carpeta de imágenes del usuario
      "/home/kali/Imágenes/**": "allow",
      // Acceso a la carpeta de descargas del usuario
      "/home/kali/Descargas/**": "allow",
      // Acceso a la carpeta de documentos del usuario
      "/home/kali/Documentos/**": "allow",
      // Acceso a la carpeta de escritorio del usuario
      "/home/kali/Escritorio/**": "allow",
      // Acceso a /tmp y subdirectorios
      "/tmp/**": "allow"
    }
  },

  // --- Servidores MCP (Model Context Protocol) ---
  "mcp": {
    // Servidor de acceso al sistema de archivos local
    "filesystem": {
      // Tipo de servidor MCP (local o remote)
      "type": "local",
      // Habilita este servidor MCP
      "enabled": true,
      // Comando para iniciar el servidor con directorio home como raíz
      "command": [
        "npx",
        "@modelcontextprotocol/server-filesystem",
        "/home/kali"
      ]
    },
    // Servidor de documentación de librerías (Context7)
    "context7": {
      // Tipo de servidor MCP (local o remote)
      "type": "local",
      // Habilita este servidor MCP
      "enabled": true,
      // Comando para iniciar el servidor
      "command": [
        "npx",
        "@upstash/context7-mcp"
      ]
    },
    // Servidor de integración con Notion (desactivado)
    "notion": {
      // Tipo de servidor MCP (local o remote)
      "type": "local",
      // Habilita este servidor MCP (desactivado)
      "enabled": false,
      // Comando para iniciar el servidor con ruta completa a nvm node
      "command": [
        "/home/kali/.nvm/versions/node/v20.20.2/bin/npx",
        "@notionhq/notion-mcp-server"
      ]
    },
    // Servidor de automatización de navegador (Playwright)
    "playwright": {
      // Tipo de servidor MCP (local o remote)
      "type": "local",
      // Habilita este servidor MCP
      "enabled": true,
      // Comando para iniciar el servidor
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      // Ruta al binario de Chromium para Playwright
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/usr/bin/chromium",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/usr/bin/chromium",
        "BROWSER": "chromium"
      }
    },
    // Servidor de integración con Blender 3D (desactivado)
    "blender-mcp": {
      // Tipo de servidor MCP (local o remote)
      "type": "local",
      // Habilita este servidor MCP (desactivado)
      "enabled": false,
      // Comando para iniciar el servidor
      "command": [
        "/home/kali/.local/bin/blender-mcp"
      ]
    },
    // Servidor de indexación semántica del código (codebase-index)
    "codebase-index": {
      // Tipo de servidor MCP (local o remote)
      "type": "local",
      // Habilita este servidor MCP
      "enabled": true,
      // Comando para iniciar el servidor con proyecto actual
      "command": [
        "opencode-codebase-index-mcp",
        "--project",
        "."
      ],
      // Variables de entorno para ollama en red local (192.168.2.138)
      "env": {
        // Host del servidor Ollama para embeddings
        "OLLAMA_HOST": "http://192.168.2.138:11434",
        // Proveedor de embeddings (ollama)
        "EMBEDDING_PROVIDER": "ollama",
        // URL base del servidor Ollama para embeddings
        "OLLAMA_BASE_URL": "http://192.168.2.138:11434",
        // Modelo de embeddings a usar (nomic-embed-text)
        "EMBEDDING_MODEL": "nomic-embed-text"
      }
    }
  },

  // --- Configuración del proveedor de IA ---
  "provider": {
    "omlx-local": {
      // Paquete npm del adaptador OpenAI compatible
      "npm": "@ai-sdk/openai-compatible",
      // Nombre descriptivo del proveedor
      "name": "MacBook Pro oMLX",
      // Formato de parsing de herramientas (tools) del modelo
      "tool_parser": "markdown",
      // Formato de formateo de herramientas para enviar al modelo
      "tools_format": "xml",
      // No valida estrictamente el schema de herramientas
      "strict_tools": false,
      "options": {
        // URL base de la API del modelo (proxy que remueve top_p, reenvía a OMLX)
        // El proxy corre en localhost:8082 (omlx-top-p-stripper-v2, streaming)
        // Ver: /home/kali/.config/opencode/plugins/omlx-top-p-stripper.py
        "baseURL": "http://127.0.0.1:8081/v1",
        "stream": true
        //"baseURL": "http://192.168.2.138:8080/v1"
      },
      "models": {
        "KAT-Coder-V2.5-Dev-VL-oQ4e-mtp": {
          // Nombre del modelo a usar
          "name": "KAT-Coder-V2.5-Dev-VL-oQ4e-mtp",
          "limit": {
            // Máximo de tokens de contexto total (75K)
            "context": 75000,
            // Máximo de tokens de entrada (igual a context para que reserved funcione)
            "input": 75000,
            // Máximo de tokens de respuesta (sincronizado con OMLX max_tokens)
            "output": 15384
          },
          "cost": {
            // Costo por 1M de tokens de entrada (USD)
            "input": 0.17,
            // Costo por 1M de tokens de salida (USD)
            "output": 0.69
          },
          "modalities": {
            // Tipos de input que acepta el modelo (solo texto)
            "input": [
              "text",
              "image"
            ],
            // Tipos de output que genera el modelo (solo texto)
            "output": [
              "text"
            ]
          },
          "options": {
            // Máximo de tokens para razonamiento/pensamiento del modelo
            "max_thinking_tokens": 2048
          }
        },
        "KAT-Coder-V2.5-Dev-OptiQ-4bit": {
          // Nombre del modelo a usar
          "name": "KAT-Coder-V2.5-Dev-OptiQ-4bit",
          "limit": {
            // Máximo de tokens de contexto total (100K)
            "context": 75000,
            // Máximo de tokens de entrada (igual a context para que reserved funcione)
            "input": 75000,
            // Máximo de tokens de respuesta (sincronizado con OMLX max_tokens)
            "output": 15384
          },
          "cost": {
            // Costo por 1M de tokens de entrada (USD)
            "input": 0.17,
            // Costo por 1M de tokens de salida (USD)
            "output": 0.69
          },
          "modalities": {
            // Tipos de input que acepta el modelo (solo texto)
            "input": [
              "text"
            ],
            // Tipos de output que genera el modelo (solo texto)
            "output": [
              "text"
            ]
          },
          "options": {
            // Máximo de tokens para razonamiento/pensamiento del modelo
            "max_thinking_tokens": 2048
          }
        }
      }
    },
    // Servidor de inferencia local con llama.cpp (Gemma 4)
    "llama-cpp": {
      // Paquete npm del adaptador OpenAI compatible
      "npm": "@ai-sdk/openai-compatible",
      // Nombre descriptivo del proveedor
      "name": "llama.cpp Gemma 4",
      // Formato de parsing de herramientas (tools) del modelo
      "tool_parser": "markdown",
      // Formato de formateo de herramientas para enviar al modelo
      "tools_format": "xml",
      // No valida estrictamente el schema de herramientas
      "strict_tools": false,
      "options": {
        // URL base de la API de llama-server corriendo en puerto 8082
        "baseURL": "http://192.168.2.138:8082/v1"
      },
      "models": {
        "gemma-4-E4B-it-qat-UD-Q4_K_XL": {
          // Nombre del modelo a usar
          "name": "gemma-4-E4B-it-qat-UD-Q4_K_XL",
          "limit": {
            // Máximo de tokens de contexto total (128K)
            "context": 131072,
            // Máximo de tokens de entrada (igual a context para que reserved funcione)
            "input": 131072,
            // Máximo de tokens de respuesta
            "output": 32768
          },
          "cost": {
            // Costo por 1M de tokens de entrada (USD) - modelo local, costo 0
            "input": 0,
            // Costo por 1M de tokens de salida (USD) - modelo local, costo 0
            "output": 0
          },
          "modalities": {
            // Tipos de input que acepta el modelo (texto + imágenes)
            "input": [
              "text",
              "image"
            ],
            // Tipos de output que genera el modelo (solo texto)
            "output": [
              "text"
            ]
          },
          "options": {
            // Máximo de tokens para razonamiento/pensamiento del modelo (thinking mode)
            "max_thinking_tokens": 8192
          }
        }
      }
    }
  },

  // --- Parámetros de los agentes internos (build y plan) ---
  "agent": {
    // Agente de construcción: genera código y ejecuta tareas complejas
    "build": {
      // Temperatura de muestreo (0.45 = equilibrado entre creatividad y precisión)
      "temperature": 1,
      // Top-k: considera solo los k tokens más probables (35 = moderado)
      "top_k": 20,
      // Penalización por repetición (1.06 = leve penalización para modelo 4-bit)
      "repetition_penalty": 1.06
    },
    // Agente de planificación: analiza y planifica antes de ejecutar
    "plan": {
      // Temperatura más baja (0.25 = más determinista y enfocado)
      "temperature": 1,
      // Top-k más bajo (20 = menos opciones, más preciso)
      "top_k": 20,
      // Penalización por repetición más suave (1.05)
      "repetition_penalty": 1.04
    }
  },

  // Modelo por defecto para todas las sesiones
  "model": "Qwen3.6-35B-A3B-4bit",

  // Lista de plugins a cargar al iniciar opencode
  "plugin": [
    "oc-tps@latest",
    "opencode-codebase-index",
    "opencode-notify"
  ],

  // Shell que usa opencode para ejecutar comandos del sistema
  "shell": "/usr/bin/zsh"
}
